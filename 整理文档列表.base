properties:
  note.processed:
    displayName: 文章发布日期
views:
  - type: table
    name: 表格
    filters:
      and:
        - file.inFolder("整理")
        - and:
            - file.folder.contains("arXiv")
    order:
      - file.name
      - processed
      - file.tags
      - file.folder
    sort:
      - property: processed
        direction: DESC
    columnSize:
      file.name: 457
